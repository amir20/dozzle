{
  "name": "dozzle",
  "version": "11.5.0",
  "description": "Realtime log viewer for docker containers.",
  "homepage": "https://github.com/amir20/dozzle#readme",
  "bugs": {
    "url": "https://github.com/amir20/dozzle/issues"
  },
  "packageManager": "bun@1.4.5",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir20/dozzle.git"
  },
  "license": "MIT",
  "author": "Amir Raminfar <findamir@gmail.com>",
  "scripts": {
    "agent:dev": "DEV=true air -- agent --level debug --agent-addr localhost:${AGENT_PORT:-7007}",
    "watch:frontend": "bun scripts/fetch-duckdb-extensions.js && bun --bun vite --port ${VITE_PORT:-5173} --strictPort",
    "watch:backend": "DOZZLE_DEV_HOST_ROOT=${DOZZLE_DEV_HOST_ROOT:-tmp/host} LIVE_FS=true DEV=true air -- --level debug --addr localhost:${DOZZLE_PORT:-3100}",
    "dev": "bun --bun concurrently --kill-others \"bun:watch:*\"",
    "dev:auto": "DEV_NO_OPEN=1 bun scripts/dev-ports.mjs bun run dev",
    "build": "bun scripts/fetch-duckdb-extensions.js && bun --bun vite build && bun scripts/compress-dist.js",
    "preview": "LIVE_FS=true air -- --addr localhost:${DOZZLE_PORT:-3100}",
    "release": "bumpp",
    "lint": "bun --bun eslint .",
    "test": "TZ=UTC vitest",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "bun --bun vitepress dev docs --open",
    "docs:build": "bun --bun vitepress build docs",
    "docs:preview": "bun --bun vitepress preview docs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.1",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/octicon": "^1.2.41",
    "@iconify-json/ph": "^1.2.2",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@vueuse/core": "^15.1.0",
    "@vueuse/integrations": "^15.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ansi_up": "^6.0.6",
    "daisyui": "5.8.3",
    "fuse.js": "^7.5.0",
    "lodash.debounce": "^4.0.8",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "sortablejs": "^1.15.7",
    "splitpanes": "^4.1.2",
    "strip-ansi": "^7.2.0",
    "tailwindcss": "4.3.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.4.0",
    "vite-plugin-vue-layouts-next": "^3.3.1",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "1.6.4",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.24",
    "vue-router": "^5.5.2"
  },
  "devDependencies": {
    "@apache-arrow/esnext-esm": "^21.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@iconify-json/ion": "^1.2.8",
    "@iconify-json/material-symbols-light": "^1.2.102",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.104",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.5",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.11",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/compiler-sfc": "^3.5.46",
    "@vue/test-utils": "^2.6.0",
    "bumpp": "^12.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2",
    "vitepress-plugin-llms": "^1.15.0",
    "vitest": "^5.1.2",
    "vue-component-type-helpers": "3.3.14",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14",
    "yaml": "^2.9.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --bun lint-staged --allow-empty"
  },
  "overrides": {
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.19.tsgo.7.0.2"
  },
  "trustedDependencies": [
    "esbuild",
    "simple-git-hooks"
  ]
}
