{
  "name": "dozzle",
  "version": "11.1.1",
  "description": "Realtime log viewer for docker containers.",
  "homepage": "https://github.com/amir20/dozzle#readme",
  "bugs": {
    "url": "https://github.com/amir20/dozzle/issues"
  },
  "packageManager": "bun@1.4.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amir20/dozzle.git"
  },
  "license": "ISC",
  "author": "Amir Raminfar <findamir@gmail.com>",
  "scripts": {
    "agent:dev": "DEV=true air -- agent --level debug --agent-addr localhost:${AGENT_PORT:-7007}",
    "watch:frontend": "bun --bun vite --port ${VITE_PORT:-5173} --strictPort --open http://localhost:${DOZZLE_PORT:-3100}/",
    "watch:backend": "LIVE_FS=true DEV=true air -- --level debug --addr localhost:${DOZZLE_PORT:-3100}",
    "dev": "bun --bun concurrently --kill-others \"bun:watch:*\"",
    "dev:auto": "bun scripts/dev-ports.mjs bun run dev",
    "build": "bun --bun vite build && bun scripts/compress-dist.js",
    "preview": "LIVE_FS=true air -- --addr localhost:${DOZZLE_PORT:-3100}",
    "release": "bumpp",
    "lint": "bun --bun eslint .",
    "test": "TZ=UTC vitest",
    "typecheck": "vue-tsc --noEmit",
    "docs:dev": "bun --bun vitepress dev docs --open",
    "docs:build": "bun --bun vitepress build docs",
    "docs:preview": "bun --bun vitepress preview docs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@iconify-json/carbon": "^1.2.27",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mdi-light": "^1.2.2",
    "@iconify-json/octicon": "^1.2.35",
    "@iconify-json/ph": "^1.2.2",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/router": "15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "codemirror": "^6.0.2",
    "daisyui": "5.7.42",
    "entities": "^8.1.0",
    "fuse.js": "^7.5.0",
    "lodash.debounce": "^4.0.8",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "sortablejs": "^1.15.7",
    "splitpanes": "^4.1.2",
    "strip-ansi": "^7.2.0",
    "tailwindcss": "4.3.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^24.0.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "8.3.0",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-svg-loader": "^5.1.3",
    "vitepress": "1.6.4",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@apache-arrow/esnext-esm": "^21.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/material-symbols-light": "^1.2.93",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.96",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.2",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.6.1",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "@vue/test-utils": "^2.5.1",
    "bumpp": "^12.3.0",
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "eventsourcemock": "^2.0.0",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "ts-node": "^10.9.2",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2",
    "vitest": "^5.0.1",
    "vue-component-type-helpers": "3.3.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --bun lint-staged --allow-empty"
  },
  "overrides": {
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2"
  },
  "trustedDependencies": [
    "esbuild",
    "simple-git-hooks"
  ]
}
